<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{% if title %}{{ title }}{% else %}{{ site.name }} | Downsizing &amp; Home Sales in {{ site.city }}{% endif %}</title>
<meta name="description" content="{{ description or site.defaultDescription }}" />
<link rel="canonical" href="{{ site.url }}{{ page.url }}" />

<meta property="og:type" content="{{ ogType or 'website' }}" />
<meta property="og:title" content="{{ ogTitle or title or site.name }}" />
<meta property="og:description" content="{{ description or site.defaultDescription }}" />
<meta property="og:url" content="{{ site.url }}{{ page.url }}" />
<meta property="og:image" content="{{ site.url }}{{ image or '/assets/og-image.jpg' }}" />
<meta property="og:site_name" content="{{ site.name }}" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{ ogTitle or title or site.name }}" />
<meta name="twitter:description" content="{{ description or site.defaultDescription }}" />
<meta name="twitter:image" content="{{ site.url }}{{ image or '/assets/og-image.jpg' }}" />
{% if noindex %}<meta name="robots" content="noindex, nofollow" />{% endif %}

<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
<link rel="apple-touch-icon" href="/assets/favicon-180.png" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Libre+Franklin:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/site.css" />
</head>
<body>
{% include "header.njk" %}
{{ content | safe }}
{% include "footer.njk" %}
<script src="/assets/js/site.js" defer></script>
</body>
</html>
