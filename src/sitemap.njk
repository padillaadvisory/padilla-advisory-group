---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ site.url }}/</loc><changefreq>weekly</changefreq><priority>1.0</priority></url>
  <url><loc>{{ site.url }}/blog/</loc><changefreq>weekly</changefreq><priority>0.9</priority></url>
  {% for post in collections.posts %}
  <url><loc>{{ site.url }}{{ post.url }}</loc><lastmod>{{ post.date | yyyymmdd }}</lastmod><changefreq>monthly</changefreq><priority>0.7</priority></url>
  {% endfor %}
  {% for loc in collections.locations %}
  <url><loc>{{ site.url }}{{ loc.url }}</loc><changefreq>monthly</changefreq><priority>0.8</priority></url>
  {% endfor %}
  <url><loc>{{ site.url }}/assets/la-downsizers-playbook.pdf</loc><changefreq>monthly</changefreq><priority>0.6</priority></url>
</urlset>
